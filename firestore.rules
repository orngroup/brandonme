rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in user (your four accounts) can read and write
    // enquiries and meta. The public events-chat writes enquiries too,
    // but only via an authenticated context, so keep it auth-only.
    match /enquiries/{doc} {
      allow read, write: if request.auth != null;
    }
    match /meta/{doc} {
      allow read, write: if request.auth != null;
    }
    match /marketing/{doc} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
